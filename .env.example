# Copy to .env and source it before starting either service:
#   set -a && source .env && set +a
#
# Both services must share NORTHGATE_JWT_SECRET — toll-service signs tokens
# with it and audit-service validates them. Neither has a default, so an
# unset value fails at startup instead of falling back to a known secret.
# Use at least 32 characters; HS256 requires a 256-bit key.
NORTHGATE_JWT_SECRET=change-me-to-a-random-32-byte-minimum-value

# Optional — these fall back to the local defaults when unset.
#NORTHGATE_DB_URL=jdbc:postgresql://localhost:5432/northgate_toll
#NORTHGATE_DB_USER=your-postgres-user
#NORTHGATE_DB_PASSWORD=
#NORTHGATE_MONGO_URI=mongodb://localhost:27017/northgate_audit
#NORTHGATE_AUDIT_URL=http://localhost:8081
# Copy to .env and fill in. Values are examples, not credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
